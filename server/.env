# Server Configuration
NODE_ENV=development
PORT= 8000

# AI / OpenRouter Configuration
# Get a free API key at https://openrouter.ai — leave blank to use rule-based scoring only
OPENROUTER_API_KEY
# Free model options: meta-llama/llama-3.1-8b-instruct:free | google/gemma-2-9b-it:free
OPENROUTER_MODEL

# Database Configuration
MONGODB_URI

# JWT Configuration
JWT_SECRET
JWT_EXPIRES_IN
JWT_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN

# Frontend URL (for CORS and email links)
FRONTEND_URL

# Email Configuration
# For development, you can use Gmail or Ethereal Email
EMAIL_SERVICE
EMAIL_USER
EMAIL_PASSWORD
EMAIL_FROM

# For development with Ethereal Email (fake SMTP)
ETHEREAL_USER
ETHEREAL_PASS

# For production, use services like SendGrid, AWS SES, etc.
# SENDGRID_API_KEY
# AWS_SES_ACCESS_KEY_ID
# AWS_SES_SECRET_ACCESS_KEY
# AWS_SES_REGION

# Security
BCRYPT_SALT_ROUNDS

# Rate Limiting (optional)
# RATE_LIMIT_WINDOW_MS
# RATE_LIMIT_MAX_REQUESTS

# Logging
LOG_LEVEL

# File Upload (for future use)
# MAX_FILE_SIZE
# UPLOAD_PATH 
